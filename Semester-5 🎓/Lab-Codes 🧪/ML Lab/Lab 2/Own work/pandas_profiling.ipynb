       "//# sourceMappingURL=bootstrap.bundle.min.js.map&lt;/script&gt;&lt;script&gt;document.addEventListener(&quot;DOMContentLoaded&quot;, () =&gt; {\n",
       "    /* Tooltip */\n",
       "    document.querySelectorAll(&#x27;[data-bs-toggle=&quot;tooltip&quot;]&#x27;).forEach(el =&gt; new bootstrap.Tooltip(el));\n",
       "\n",
       "    /* Link */\n",
